{
  "name": "sowa-kouji-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "bootstrap:admin": "node src/cli/bootstrap-admin.js",
    "test": "node --test tests/*.test.mjs",
    "test:postgres": "node --test tests/postgres-provider.test.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "firebase-admin": "^14.3.0",
    "pg": "^8.16.3"
  },
  "overrides": {
    "firebase-admin": {
      "@google-cloud/storage": "$@google-cloud/storage"
    }
  }
}
