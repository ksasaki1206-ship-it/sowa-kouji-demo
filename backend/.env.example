PORT=8080
NODE_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:8081
DATA_PROVIDER=memory
MOCK_AUTH_ENABLED=true
AUTH_MODE=mock
IDENTITY_PROVIDER=fake

# 正式認証時のみ。Web API keyは公開client設定ですが実値はrepositoryへcommitしません。
IDENTITY_PROJECT_ID=local-reference-193012
IDENTITY_AUTH_DOMAIN=local-reference-193012.firebaseapp.com
IDENTITY_WEB_API_KEY=

# 15分以内に5回失敗すると15分lockします。
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# HTTP正式modeの写真本体。development/testはmemory、本番はprivate GCS bucketを使用します。
PHOTO_STORAGE=memory
PHOTO_BUCKET=
PHOTO_MAX_BYTES=4194304
PHOTO_READ_URL_TTL_SECONDS=600

# 初期admin作成時だけ設定。password本体はstdinまたはSecret Manager等のmount fileから渡します。
BOOTSTRAP_ADMIN_LOGIN_ID=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD_FILE=

# PostgreSQL利用時だけ設定。実値・passwordはcommitしないでください。
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false
DATABASE_POOL_MAX=10
RUN_MIGRATIONS=false

# Cloud Run + Cloud SQL Unix socketではDATABASE_URLの代わりに設定します。
INSTANCE_CONNECTION_NAME=PROJECT:REGION:INSTANCE
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
